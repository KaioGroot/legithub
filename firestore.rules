rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Licenses: leitura livre para validação, escrita restrita
    match /licenses/{key} {
      // Qualquer um pode ler (launcher valida key)
      allow read: if true;

      // Escrita: apenas via Firebase Console ou Admin SDK
      // (para criar keys manualmente ou via script)
      allow write: if request.auth != null;
    }
  }
}
