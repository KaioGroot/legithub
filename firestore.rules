rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Toda leitura/escrita por clientes e REST sujeitos a rules e bloqueada.
    // O acesso a collection licenses agora acontece apenas via servico
    // (Cloudflare Worker legithub-auth / bot Discloud), que usa service
    // account (OAuth) e ignora security rules.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}